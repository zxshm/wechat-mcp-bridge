# 复制到仓库外的私有配置文件，按自己的部署填写。
BRIDGE_STATE_DIR=/absolute/path/to/private-state
BRIDGE_OWNER_EMAIL=owner@example.com
BRIDGE_ACCESS_ISSUER=https://access.example.com
BRIDGE_ACCESS_AUDIENCE=replace-with-your-access-application-audience
BRIDGE_PUBLIC_HOST=mcp.example.com
BRIDGE_PORT=4181
# 原聊天与当前微信 MCP 连接的实际标识。
BRIDGE_ROOM_ID=replace-with-your-chat-room-id
BRIDGE_MCP_LINK_ID=replace-with-your-mcp-link-id
XDW_SOURCE_LEDGER=1
XDW_LARGE_MEDIA=1
BRIDGE_LARGE_MEDIA_ROOT=/absolute/path/to/private-state/large-media
BRIDGE_LARGE_MEDIA_RUNTIME_DIR=/absolute/path/to/private-runtime/wechat-large-media
BRIDGE_LARGE_MEDIA_SOCKET=/absolute/path/to/private-runtime/wechat-large-media/control.sock
BRIDGE_LARGE_MEDIA_BRIDGE_SOCKET=/absolute/path/to/private-runtime/wechat-large-media-bridge/control.sock
BRIDGE_FILE_UPLOAD_ORIGIN=https://files.example.com
# 可选的有界诊断，保存在私有状态目录。
XDW_MCP_DIAGNOSTICS=0
# 可选 SOCKS 代理，省略时直连。
# BRIDGE_SOCKS_HOST=proxy.example.com
# BRIDGE_SOCKS_PORT=1080
