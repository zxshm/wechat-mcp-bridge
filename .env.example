# Copy to a private file outside the repository. Values here are placeholders.
BRIDGE_STATE_DIR=/absolute/path/to/private-state
BRIDGE_OWNER_EMAIL=owner@example.com
BRIDGE_ACCESS_ISSUER=https://access.example.com
BRIDGE_ACCESS_AUDIENCE=replace-with-your-access-application-audience
BRIDGE_PUBLIC_HOST=mcp.example.com
BRIDGE_PORT=4181
# Optional diagnostics contain only bounded metadata, but still belong in private state.
XDW_MCP_DIAGNOSTICS=0
# Optional SOCKS proxy; omit both to connect directly.
# BRIDGE_SOCKS_HOST=proxy.example.com
# BRIDGE_SOCKS_PORT=1080
