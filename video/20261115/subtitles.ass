Dialogue: 0,0:00:00.08,0:00:00.68,Default,,0,0,0,,大家好
Dialogue: 0,0:00:01.12,0:00:04.52,Default,,0,0,0,,上一期我们把微信接到了 Codex 的 Dot
Dialogue: 0,0:00:04.80,0:00:06.04,Default,,0,0,0,,打通了文字
Dialogue: 0,0:00:06.08,0:00:08.36,Default,,0,0,0,,图片和文件的基础收发
Dialogue: 0,0:00:08.80,0:00:10.52,Default,,0,0,0,,这次第二次大更新
Dialogue: 0,0:00:10.64,0:00:13.32,Default,,0,0,0,,我们把使用方式又往前推了一步
Dialogue: 0,0:00:13.68,0:00:17.48,Default,,0,0,0,,核心变化是让原来的小弟通过自定义指令
Dialogue: 0,0:00:17.68,0:00:21.32,Default,,0,0,0,,主动把当前聊天的问题和回答同步到微信
Dialogue: 0,0:00:21.44,0:00:21.96,Default,,0,0,0,,同时
Dialogue: 0,0:00:22.24,0:00:24.20,Default,,0,0,0,,云端百兆文件直传
Dialogue: 0,0:00:24.48,0:00:27.88,Default,,0,0,0,,断点续传和持久运行也已经接上
Dialogue: 0,0:00:28.32,0:00:30.52,Default,,0,0,0,,今天用一条完整工作流
Dialogue: 0,0:00:30.64,0:00:32.36,Default,,0,0,0,,讲清楚这次的方案
Dialogue: 0,0:00:32.48,0:00:34.28,Default,,0,0,0,,优势和实际进展
Dialogue: 0,0:00:34.49,0:00:35.89,Default,,0,0,0,,先看最直接的场景
Dialogue: 0,0:00:36.25,0:00:38.21,Default,,0,0,0,,你在电脑或者其他设备上
Dialogue: 0,0:00:38.41,0:00:40.05,Default,,0,0,0,,打开同一个小弟聊天
Dialogue: 0,0:00:40.09,0:00:40.93,Default,,0,0,0,,提出问题
Dialogue: 0,0:00:41.37,0:00:44.21,Default,,0,0,0,,小弟先在当前对话里给出正常回答
Dialogue: 0,0:00:44.41,0:00:45.81,Default,,0,0,0,,然后执行同步
Dialogue: 0,0:00:46.01,0:00:50.37,Default,,0,0,0,,把这轮用户问题和助手回答按顺序送到本人微信
Dialogue: 0,0:00:51.05,0:00:52.53,Default,,0,0,0,,离开当前页面以后
Dialogue: 0,0:00:52.65,0:00:55.09,Default,,0,0,0,,你还可以在微信里继续查看结果
Dialogue: 0,0:00:55.21,0:00:57.01,Default,,0,0,0,,微信发来的新消息
Dialogue: 0,0:00:57.13,0:00:59.97,Default,,0,0,0,,则由接收任务交给同一个小弟处理
Dialogue: 0,0:01:00.17,0:01:03.17,Default,,0,0,0,,再把来信和回复镜像回原聊天
Dialogue: 0,0:01:03.38,0:01:05.10,Default,,0,0,0,,这次最重要的策略调整
Dialogue: 0,0:01:05.22,0:01:06.54,Default,,0,0,0,,就在小弟这一侧
Dialogue: 0,0:01:06.82,0:01:09.58,Default,,0,0,0,,我们在原聊天右上角的自定义指令里
Dialogue: 0,0:01:09.70,0:01:12.86,Default,,0,0,0,,明确写入每次普通问答的同步职责
Dialogue: 0,0:01:13.14,0:01:14.94,Default,,0,0,0,,小弟完成回答发布后
Dialogue: 0,0:01:15.06,0:01:17.34,Default,,0,0,0,,直接调用微信 MCP 工具
Dialogue: 0,0:01:17.54,0:01:18.86,Default,,0,0,0,,读取真实消息
Dialogue: 0,0:01:18.98,0:01:20.54,Default,,0,0,0,,核验来源并入队
Dialogue: 0,0:01:20.82,0:01:23.18,Default,,0,0,0,,Minihome 负责执行队列和发送
Dialogue: 0,0:01:23.38,0:01:23.74,Default,,0,0,0,,这样
Dialogue: 0,0:01:23.94,0:01:26.54,Default,,0,0,0,,聊天本身就有了明确的同步行为
Dialogue: 0,0:01:26.82,0:01:29.66,Default,,0,0,0,,日常文字同步可以从云端直接完成
Dialogue: 0,0:01:29.86,0:01:33.42,Default,,0,0,0,,也摆脱了持续观察 Windows 界面带来的运行依赖
Dialogue: 0,0:01:33.55,0:01:36.39,Default,,0,0,0,,提示词里的目标可以说得很简单
Dialogue: 0,0:01:36.83,0:01:40.31,Default,,0,0,0,,把本聊天的新问题和回答同步到微信
Dialogue: 0,0:01:40.67,0:01:43.11,Default,,0,0,0,,执行层还需要把动作写清楚
Dialogue: 0,0:01:43.47,0:01:46.87,Default,,0,0,0,,先取得这轮已经发布的真实消息编号
Dialogue: 0,0:01:47.31,0:01:49.91,Default,,0,0,0,,再读取完整正文和作者信息
Dialogue: 0,0:01:50.19,0:01:53.51,Default,,0,0,0,,核对本人微信事件以及已有记录
Dialogue: 0,0:01:53.95,0:01:55.91,Default,,0,0,0,,最后按问题在前
Dialogue: 0,0:01:56.11,0:01:58.15,Default,,0,0,0,,回答在后的顺序提交
Dialogue: 0,0:01:58.35,0:02:00.39,Default,,0,0,0,,正常同步静默完成
Dialogue: 0,0:02:00.67,0:02:01.43,Default,,0,0,0,,文字
Dialogue: 0,0:02:01.47,0:02:05.27,Default,,0,0,0,,图片和大文件各走对应的处理流程
Dialogue: 0,0:02:05.55,0:02:09.43,Default,,0,0,0,,同一轮中能够独立完成的读取会并行执行
Dialogue: 0,0:02:09.73,0:02:12.01,Default,,0,0,0,,现在的自定义指令分成两层
Dialogue: 0,0:02:12.45,0:02:15.47,Default,,0,0,0,,前面用自然语言说明谁负责同步
Dialogue: 0,0:02:15.49,0:02:16.65,Default,,0,0,0,,同步哪些消息
Dialogue: 0,0:02:16.77,0:02:18.41,Default,,0,0,0,,以及文件怎样传递
Dialogue: 0,0:02:18.69,0:02:21.05,Default,,0,0,0,,后面保存一份固定的同步程序
Dialogue: 0,0:02:21.25,0:02:22.73,Default,,0,0,0,,负责具体的读取
Dialogue: 0,0:02:22.85,0:02:23.45,Default,,0,0,0,,核验
Dialogue: 0,0:02:23.57,0:02:25.13,Default,,0,0,0,,预占和结果记录
Dialogue: 0,0:02:25.57,0:02:28.97,Default,,0,0,0,,小弟可以在一次连续执行里调用这份程序
Dialogue: 0,0:02:29.17,0:02:32.17,Default,,0,0,0,,减少每一步都重新规划和重复准备
Dialogue: 0,0:02:32.37,0:02:36.09,Default,,0,0,0,,它使用原消息的稳定身份关联发送记录
Dialogue: 0,0:02:36.37,0:02:37.61,Default,,0,0,0,,让聊天内容
Dialogue: 0,0:02:37.73,0:02:40.89,Default,,0,0,0,,队列和发送回执能够对应起来
Dialogue: 0,0:02:41.01,0:02:44.65,Default,,0,0,0,,这轮还修复了一个真实影响日常使用的问题
Dialogue: 0,0:02:44.93,0:02:50.89,Default,,0,0,0,,早期把同步程序和微信事件索引放在临时运行缓存里
Dialogue: 0,0:02:51.09,0:02:52.25,Default,,0,0,0,,缓存丢失以后
Dialogue: 0,0:02:52.29,0:02:53.71,Default,,0,0,0,,小弟就找不到它们
Dialogue: 0,0:02:53.73,0:02:55.77,Default,,0,0,0,,后面的问答会停止同步
Dialogue: 0,0:02:55.97,0:02:59.37,Default,,0,0,0,,现在完整程序已经写进持久自定义指令
Dialogue: 0,0:02:59.57,0:03:00.73,Default,,0,0,0,,缓存缺失时
Dialogue: 0,0:03:00.77,0:03:03.13,Default,,0,0,0,,小弟从固定配置恢复程序
Dialogue: 0,0:03:03.33,0:03:05.45,Default,,0,0,0,,分页读取保留的微信记录
Dialogue: 0,0:03:05.65,0:03:08.41,Default,,0,0,0,,取得最新本人事件再继续处理
Dialogue: 0,0:03:08.53,0:03:11.13,Default,,0,0,0,,无缓存恢复和紧接着的新问答
Dialogue: 0,0:03:11.33,0:03:13.61,Default,,0,0,0,,已经分别完成了真实发送测试
Dialogue: 0,0:03:13.81,0:03:15.37,Default,,0,0,0,,这套方案的使用优势
Dialogue: 0,0:03:15.57,0:03:18.41,Default,,0,0,0,,是把同步跟在同一个小弟对话后面
Dialogue: 0,0:03:18.61,0:03:20.57,Default,,0,0,0,,客户端换成另一台设备
Dialogue: 0,0:03:20.69,0:03:22.97,Default,,0,0,0,,仍然可以沿用这个聊天的规则
Dialogue: 0,0:03:23.25,0:03:26.81,Default,,0,0,0,,文字同步由小弟和 Linux 桥配合完成
Dialogue: 0,0:03:27.09,0:03:29.05,Default,,0,0,0,,Windows 主要用于开发
Dialogue: 0,0:03:29.09,0:03:30.81,Default,,0,0,0,,管理和浏览器操作
Dialogue: 0,0:03:31.09,0:03:33.05,Default,,0,0,0,,文件在云端生成时
Dialogue: 0,0:03:33.17,0:03:35.29,Default,,0,0,0,,也可以直接上传到 Minihome
Dialogue: 0,0:03:35.49,0:03:37.45,Default,,0,0,0,,再进入微信发送流程
Dialogue: 0,0:03:37.65,0:03:38.65,Default,,0,0,0,,离开电脑以后
Dialogue: 0,0:03:38.77,0:03:41.93,Default,,0,0,0,,微信就成为继续查看和发起任务的入口
Dialogue: 0,0:03:42.08,0:03:42.68,Default,,0,0,0,,反过来
Dialogue: 0,0:03:42.80,0:03:45.48,Default,,0,0,0,,从微信出发也有一条完整链路
Dialogue: 0,0:03:45.76,0:03:48.68,Default,,0,0,0,,桥接服务读取本人单聊的新消息
Dialogue: 0,0:03:48.88,0:03:51.80,Default,,0,0,0,,保存事件并通知小弟的接收任务
Dialogue: 0,0:03:52.00,0:03:53.32,Default,,0,0,0,,小弟读取消息
Dialogue: 0,0:03:53.44,0:03:54.36,Default,,0,0,0,,生成回答
Dialogue: 0,0:03:54.56,0:03:56.68,Default,,0,0,0,,再通过原微信连接发送
Dialogue: 0,0:03:56.96,0:03:59.64,Default,,0,0,0,,来信和回复会显示回原聊天
Dialogue: 0,0:03:59.84,0:04:01.72,Default,,0,0,0,,方便在客户端继续跟进
Dialogue: 0,0:04:01.92,0:04:04.28,Default,,0,0,0,,当前使用 GPT 六点一 Sol
Dialogue: 0,0:04:04.40,0:04:05.64,Default,,0,0,0,,中等推理强度
Dialogue: 0,0:04:05.76,0:04:09.40,Default,,0,0,0,,接收任务和当前对话的转发职责已经写清
Dialogue: 0,0:04:09.84,0:04:12.68,Default,,0,0,0,,消息通过同一个工作流继续处理
Dialogue: 0,0:04:12.81,0:04:16.61,Default,,0,0,0,,图片和文件让这条连接真正进入工作场景
Dialogue: 0,0:04:16.81,0:04:19.89,Default,,0,0,0,,你可以在微信里提供参考图片或文档
Dialogue: 0,0:04:20.09,0:04:22.21,Default,,0,0,0,,让小弟结合资料处理任务
Dialogue: 0,0:04:22.41,0:04:25.11,Default,,0,0,0,,也可以让它把生成的文件发回来
Dialogue: 0,0:04:25.13,0:04:29.57,Default,,0,0,0,,小图片和旧接口支持的附件沿用原来的媒体流程
Dialogue: 0,0:04:29.77,0:04:33.81,Default,,0,0,0,,这次重点重做了云端向微信发送大文件的通道
Dialogue: 0,0:04:33.93,0:04:37.25,Default,,0,0,0,,把原始字节传输交给程序连续执行
Dialogue: 0,0:04:37.45,0:04:40.21,Default,,0,0,0,,减少逐小块工具调用带来的等待
Dialogue: 0,0:04:40.41,0:04:42.45,Default,,0,0,0,,大文件的实际路径是这样的
Dialogue: 0,0:04:42.89,0:04:45.01,Default,,0,0,0,,小弟在云端生成文件
Dialogue: 0,0:04:45.29,0:04:47.65,Default,,0,0,0,,或者从 Library 取得原文件
Dialogue: 0,0:04:48.17,0:04:49.41,Default,,0,0,0,,创建上传以后
Dialogue: 0,0:04:49.61,0:04:51.57,Default,,0,0,0,,程序通过 HTTPS
Dialogue: 0,0:04:51.77,0:04:54.69,Default,,0,0,0,,把原始二进制字节传到 Minihome
Dialogue: 0,0:04:55.05,0:04:56.69,Default,,0,0,0,,Minihome 保存分段
Dialogue: 0,0:04:56.97,0:04:58.37,Default,,0,0,0,,拼回完整文件
Dialogue: 0,0:04:58.65,0:05:02.53,Default,,0,0,0,,核对总大小和 SHA 二五六摘要
Dialogue: 0,0:05:02.81,0:05:07.65,Default,,0,0,0,,然后由原微信桥把完整文件上传到微信 CDN
Dialogue: 0,0:05:08.09,0:05:10.05,Default,,0,0,0,,最后发送一个文件附件
Dialogue: 0,0:05:10.17,0:05:13.89,Default,,0,0,0,,整个文件数据路径都在云端和 Linux 之间运行
Dialogue: 0,0:05:14.17,0:05:15.57,Default,,0,0,0,,Windows 可以关机
Dialogue: 0,0:05:15.78,0:05:18.78,Default,,0,0,0,,分段大小按每段九千万字节来传
Dialogue: 0,0:05:19.06,0:05:22.46,Default,,0,0,0,,以这次约一亿字节的 PDF 为例
Dialogue: 0,0:05:22.74,0:05:24.54,Default,,0,0,0,,前面一段九千万字节
Dialogue: 0,0:05:24.74,0:05:26.54,Default,,0,0,0,,后面一段放剩余内容
Dialogue: 0,0:05:27.06,0:05:28.78,Default,,0,0,0,,Minihome 按顺序拼接
Dialogue: 0,0:05:29.06,0:05:31.02,Default,,0,0,0,,完整摘要相同以后
Dialogue: 0,0:05:31.06,0:05:32.70,Default,,0,0,0,,才进入微信上传
Dialogue: 0,0:05:32.98,0:05:36.22,Default,,0,0,0,,微信最终接收的是一个完整 PDF
Dialogue: 0,0:05:36.74,0:05:38.94,Default,,0,0,0,,接收服务按照磁盘空间
Dialogue: 0,0:05:39.06,0:05:41.82,Default,,0,0,0,,并发数和上传期限管理资源
Dialogue: 0,0:05:42.10,0:05:46.70,Default,,0,0,0,,大文件不再受到旧工具二十 MiB 整文件常量的约束
Dialogue: 0,0:05:46.91,0:05:49.91,Default,,0,0,0,,为了让慢速网络上的大文件也能传完
Dialogue: 0,0:05:50.03,0:05:52.39,Default,,0,0,0,,我们增加了段内断点续传
Dialogue: 0,0:05:52.59,0:05:53.83,Default,,0,0,0,,连接中断后
Dialogue: 0,0:05:53.95,0:05:56.31,Default,,0,0,0,,服务端保存已经落盘的前缀
Dialogue: 0,0:05:56.43,0:05:58.95,Default,,0,0,0,,客户端查询当前分段和偏移
Dialogue: 0,0:05:59.15,0:06:01.27,Default,,0,0,0,,从那个位置补传剩余字节
Dialogue: 0,0:06:01.55,0:06:03.75,Default,,0,0,0,,长请求会返回保活信息
Dialogue: 0,0:06:03.87,0:06:07.51,Default,,0,0,0,,状态接口还能显示当前上传是否正在占用
Dialogue: 0,0:06:07.63,0:06:07.99,Default,,0,0,0,,这样
Dialogue: 0,0:06:08.27,0:06:11.11,Default,,0,0,0,,链路波动后可以继续原来的文件传输
Dialogue: 0,0:06:11.15,0:06:14.23,Default,,0,0,0,,同时保留逐段校验和完整文件校验
Dialogue: 0,0:06:14.45,0:06:18.41,Default,,0,0,0,,这条链路已经用真实小弟云端生成的 PDF 跑通
Dialogue: 0,0:06:18.61,0:06:22.35,Default,,0,0,0,,文件大小是一亿零二千四百二十二字节
Dialogue: 0,0:06:22.37,0:06:25.13,Default,,0,0,0,,云端取回原字节后完成核对
Dialogue: 0,0:06:25.25,0:06:28.41,Default,,0,0,0,,再按九千万加一千多万字节上传
Dialogue: 0,0:06:28.69,0:06:30.09,Default,,0,0,0,,最后发送成功
Dialogue: 0,0:06:30.37,0:06:35.85,Default,,0,0,0,,实测补传第一段剩余约六千九百万字节用了八十五点八秒
Dialogue: 0,0:06:36.05,0:06:38.01,Default,,0,0,0,,第二段用了十五点六秒
Dialogue: 0,0:06:38.13,0:06:40.81,Default,,0,0,0,,Minihome 完整校验约五点三秒
Dialogue: 0,0:06:41.01,0:06:44.17,Default,,0,0,0,,微信 CDN 上传约七十七点九秒
Dialogue: 0,0:06:44.29,0:06:46.33,Default,,0,0,0,,文件消息提交约半秒
Dialogue: 0,0:06:46.55,0:06:48.99,Default,,0,0,0,,文字延迟这次做了多轮排查
Dialogue: 0,0:06:49.27,0:06:51.47,Default,,0,0,0,,我们分别记录消息发布时间
Dialogue: 0,0:06:51.59,0:06:52.51,Default,,0,0,0,,同步开始
Dialogue: 0,0:06:52.71,0:06:54.03,Default,,0,0,0,,每次工具调用
Dialogue: 0,0:06:54.23,0:06:55.47,Default,,0,0,0,,Minihome 处理
Dialogue: 0,0:06:55.59,0:06:57.39,Default,,0,0,0,,入队和微信发送
Dialogue: 0,0:06:57.75,0:07:01.07,Default,,0,0,0,,服务端现在还会保存受限长度的分段诊断
Dialogue: 0,0:07:01.27,0:07:02.91,Default,,0,0,0,,由这些数据可以看到
Dialogue: 0,0:07:03.03,0:07:07.39,Default,,0,0,0,,文字的主要等待集中在同步启动和工具往返阶段
Dialogue: 0,0:07:07.51,0:07:11.47,Default,,0,0,0,,几十毫秒的服务器处理与约半秒的微信发送
Dialogue: 0,0:07:11.75,0:07:15.07,Default,,0,0,0,,已经能够跟前面的等待清楚地区分开
Dialogue: 0,0:07:15.21,0:07:16.77,Default,,0,0,0,,已经落地的改动包括
Dialogue: 0,0:07:16.89,0:07:18.69,Default,,0,0,0,,独立读取并行执行
Dialogue: 0,0:07:18.89,0:07:21.09,Default,,0,0,0,,减少有效信息的重复查询
Dialogue: 0,0:07:21.29,0:07:22.37,Default,,0,0,0,,把来源观察
Dialogue: 0,0:07:22.41,0:07:26.93,Default,,0,0,0,,完整历史核查和首次预占合并到一次服务端接口里
Dialogue: 0,0:07:27.05,0:07:30.21,Default,,0,0,0,,调用次数从每轮十六次降到十二次
Dialogue: 0,0:07:30.41,0:07:33.33,Default,,0,0,0,,公开验证密钥也改成后台定时刷新
Dialogue: 0,0:07:33.53,0:07:35.49,Default,,0,0,0,,刷新失败以后自动恢复
Dialogue: 0,0:07:35.61,0:07:38.77,Default,,0,0,0,,减少过期后业务请求现场拉取的等待
Dialogue: 0,0:07:38.89,0:07:40.93,Default,,0,0,0,,固定程序和持久配置
Dialogue: 0,0:07:41.05,0:07:42.85,Default,,0,0,0,,则让执行步骤更一致
Dialogue: 0,0:07:43.13,0:07:45.89,Default,,0,0,0,,也解决了临时缓存丢失的问题
Dialogue: 0,0:07:46.11,0:07:47.75,Default,,0,0,0,,最新一组连续问答里
Dialogue: 0,0:07:47.79,0:07:50.55,Default,,0,0,0,,小弟约四点三七秒发布正常回答
Dialogue: 0,0:07:50.99,0:07:55.11,Default,,0,0,0,,从回答发布到微信发送成功又用了十六点四五秒
Dialogue: 0,0:07:55.31,0:07:57.27,Default,,0,0,0,,整轮约二十点八二秒
Dialogue: 0,0:07:57.55,0:08:01.91,Default,,0,0,0,,两次入队工具分别等待四点七七秒和二点六八秒
Dialogue: 0,0:08:02.19,0:08:05.99,Default,,0,0,0,,Minihome 实际处理各约三十六和三十七毫秒
Dialogue: 0,0:08:06.27,0:08:09.83,Default,,0,0,0,,无缓存恢复那组整轮约四十八点九秒
Dialogue: 0,0:08:10.03,0:08:12.39,Default,,0,0,0,,这两组数据也指出了下一步方向
Dialogue: 0,0:08:12.51,0:08:15.99,Default,,0,0,0,,继续缩短执行准备和工具之间的往返等待
Dialogue: 0,0:08:16.11,0:08:16.87,Default,,0,0,0,,部署时
Dialogue: 0,0:08:16.99,0:08:21.21,Default,,0,0,0,,在自己的 Linux 主机上运行微信桥和独立文件
Dialogue: 0,0:08:21.23,0:08:22.23,Default,,0,0,0,,接收服务
Dialogue: 0,0:08:22.35,0:08:24.87,Default,,0,0,0,,配置 HTTPS 入口
Dialogue: 0,0:08:24.99,0:08:26.31,Default,,0,0,0,,完成微信绑定
Dialogue: 0,0:08:26.51,0:08:29.11,Default,,0,0,0,,再把 MCP 连接加进客户端
Dialogue: 0,0:08:29.47,0:08:29.91,Default,,0,0,0,,接着
Dialogue: 0,0:08:30.03,0:08:33.11,Default,,0,0,0,,在原小弟聊天里写入自定义指令
Dialogue: 0,0:08:33.23,0:08:34.71,Default,,0,0,0,,说明普通问答
Dialogue: 0,0:08:34.83,0:08:37.91,Default,,0,0,0,,微信来信和附件各自怎样处理
Dialogue: 0,0:08:38.27,0:08:39.93,Default,,0,0,0,,公开仓库提供代码
Dialogue: 0,0:08:39.95,0:08:41.99,Default,,0,0,0,,配置示例和更新说明
Dialogue: 0,0:08:42.27,0:08:44.47,Default,,0,0,0,,系统服务负责长期运行
Dialogue: 0,0:08:44.67,0:08:48.81,Default,,0,0,0,,上传状态和队列回执负责记录每一步进度
Dialogue: 0,0:08:48.91,0:08:49.75,Default,,0,0,0,,这次更新
Dialogue: 0,0:08:49.79,0:08:52.15,Default,,0,0,0,,把自定义指令驱动的聊天同步
Dialogue: 0,0:08:52.27,0:08:55.75,Default,,0,0,0,,云端大文件传输和持久运行连接到了一起
Dialogue: 0,0:08:55.79,0:08:57.59,Default,,0,0,0,,你可以在客户端提出问题
Dialogue: 0,0:08:57.79,0:08:59.19,Default,,0,0,0,,在微信查看结果
Dialogue: 0,0:08:59.31,0:09:01.03,Default,,0,0,0,,也可以从微信发来资料
Dialogue: 0,0:09:01.07,0:09:02.87,Default,,0,0,0,,继续交给同一个小弟处理
Dialogue: 0,0:09:03.31,0:09:05.91,Default,,0,0,0,,接下来会沿着已经测出的耗时阶段
Dialogue: 0,0:09:06.03,0:09:08.07,Default,,0,0,0,,继续优化启动和工具往返
Dialogue: 0,0:09:08.27,0:09:10.95,Default,,0,0,0,,代码和部署资料已经同步到 GitHub
Dialogue: 0,0:09:11.31,0:09:12.71,Default,,0,0,0,,欢迎查看这个项目
Dialogue: 0,0:09:12.83,0:09:14.71,Default,,0,0,0,,也欢迎交流你的使用场景
Dialogue: 0,0:09:15.07,0:09:16.79,Default,,0,0,0,,我们下次更新再见
